# Optional local overrides for the OIDC harness. Copy to .env and uncomment.
# Precedence: run.py defaults < .env < environment < CLI flags.

# Container engine: docker (default) or podman.
#DOCKER=podman

# --- Quay image source ------------------------------------------------------
# Pull mode (default): published image to test.
#QUAY_IMAGE=quay.io/projectquay/quay:latest
# Source mode: path to a quay checkout. Setting this makes run.py build the
# quay + repomirror images from that repo (compose.build.yaml) instead of
# pulling QUAY_IMAGE, and extracts the quay-builder binary for build support.
# Required for `test` in either mode (the Playwright suite is bind-mounted
# from <QUAY_REPO_ROOT>/web).
#QUAY_REPO_ROOT=/home/nasonawa/Documents/work/quay
# Tag given to the locally built quay image in source mode.
#QUAY_BUILT_IMAGE=localhost/quay-oidc-testing-quay:latest

# --- Keycloak ----------------------------------------------------------------
# Override for the Red Hat build of Keycloak (RHBK), e.g.
# registry.redhat.io/rhbk/keycloak-rhel9:26.4
#KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.2

# --- Ports -------------------------------------------------------------------
#QUAY_HOST_PORT=18080
#KEYCLOAK_HOST_PORT=18081
#MAILPIT_HOST_PORT=18025
#JAEGER_HOST_PORT=16686
#GARAGE_HOST_PORT=13900

# --- Runner / build support ---------------------------------------------------
# user:group for the playwright container. Auto-detected (0:0 on rootless
# engines, real uid:gid otherwise); override only if detection misfires.
#DOCKER_USER=0:0
# Container-runtime Unix socket mounted into Quay for build support.
# Auto-detected from DOCKER_HOST / the docker context; set it explicitly for
# tcp:// or remote engines.
#QUAY_DOCKER_SOCKET=/var/run/docker.sock

# --- Reports -----------------------------------------------------------------
#REPORT_DIR=
#RUN_LABEL=

# --- OpenShift variant (./run.sh ocp ...) -------------------------------------
#OCP_NAMESPACE=quay-oidc-harness
#QUAY_POD_LABEL=app=quay
