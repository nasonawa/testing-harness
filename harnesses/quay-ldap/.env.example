# Optional local overrides for the LDAP harness. Copy to .env and uncomment.
# Precedence: run.py defaults < .env < environment < CLI flags.

# Container engine: docker (default) or podman.
#DOCKER=podman

# --- Quay image source ------------------------------------------------------
# Pull mode (default): published image to test. Pin a tag that contains the
# PROJQUAY-13372 redaction fix, or the verify gate will legitimately fail.
#QUAY_IMAGE=quay.io/projectquay/quay:latest
# Source mode: path to a quay checkout. Setting this makes run.py build the
# quay image from that repo (compose.build.yaml) instead of pulling QUAY_IMAGE.
# Required for `test` in either mode (the Playwright suite is bind-mounted
# from <QUAY_REPO_ROOT>/web).
#QUAY_REPO_ROOT=/home/nasonawa/Documents/work/quay
# Tag given to the locally built quay image in source mode.
#QUAY_BUILT_IMAGE=localhost/quay-ldap-testing-quay:latest

# --- Ports ------------------------------------------------------------------
#QUAY_HOST_PORT=18090
#LDAP_HOST_PORT=13389
#MAILPIT_HOST_PORT=18026

# --- Runner -----------------------------------------------------------------
# user:group for the playwright container. Auto-detected (0:0 on rootless
# engines, real uid:gid otherwise); override only if detection misfires.
#DOCKER_USER=0:0

# --- Reports ----------------------------------------------------------------
#REPORT_DIR=
#RUN_LABEL=

# --- OpenShift variant (./run.sh ocp ...) ------------------------------------
#OCP_NAMESPACE=quay-ldap-harness
#QUAY_POD_LABEL=app=quay
