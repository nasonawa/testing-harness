# Ubuntu-based Playwright runner for the LDAP test harness.
#
# Lean variant of harnesses/quay-oidc/Containerfile.playwright: the LDAP
# harness only runs the @auth:LDAP specs, so the registry CLIs (crane, regctl,
# oras, cosign), skopeo and the AWS CLI are omitted. Playwright/Chromium is
# unreliable on UBI/RHEL, so this uses Ubuntu like the OIDC harness.
#
# The build context is this harness directory; the quay checkout is attached
# as the named BuildKit context `quayrepo` (compose additional_contexts), so
# everything from the quay repo is COPY'd with --from=quayrepo. The Playwright
# version is resolved from the checkout's web/package-lock.json, matching
# web/Containerfile.playwright and the OIDC harness. Rebuild this image when
# the checkout's Playwright pin moves.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    HOME=/tmp \
    npm_config_cache=/tmp/.npm \
    OPENSHIFT_CI=1 \
    CI=1 \
    PLAYWRIGHT_SKIP_WEBSERVER=1

USER root

# Base tooling. socat provides the loopback forward used by entrypoint.sh.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      gnupg \
      git \
      socat \
      jq \
      xz-utils \
      gzip \
      tar \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install the Playwright version pinned by the lockfile plus Chromium and its
# OS dependencies. The suite only needs @playwright/test; installing the whole
# React app is unnecessary and much slower.
COPY --from=quayrepo web/package-lock.json /tmp/package-lock.json
RUN PW_VERSION=$(node -p "require('/tmp/package-lock.json').packages['node_modules/@playwright/test'].version") \
    && npm init -y > /dev/null 2>&1 \
    && npm install --no-package-lock "@playwright/test@${PW_VERSION}" \
    && npx playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright \
    && rm -rf /tmp/package-lock.json /tmp/.npm /var/lib/apt/lists/*

# Bake the suite for standalone use. compose.yaml bind-mounts the working tree
# over these paths so spec edits do not require an image rebuild.
COPY --from=quayrepo web/playwright.config.ts ./
COPY --from=quayrepo web/playwright/ ./playwright/
COPY --from=quayrepo web/tsconfig.json ./
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Runs as the host UID/GID via compose (`user:`), so no USER directive.
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["npx", "playwright", "test", "--grep", "@auth:LDAP"]
