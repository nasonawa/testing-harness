# EDIT-ME product — copy to .env and adjust. Every variable can also be
# set in the environment (env wins over .env) or left to the defaults in
# run.py. `./run.sh doctor` prints the resolved values.

# Container engine: docker | podman
DOCKER=docker

# Pull mode (default): the product image to test.
PRODUCT_IMAGE=registry.example/product:latest

# Source mode: set PRODUCT_REPO_ROOT to a product source checkout and run.py
# switches to compose.build.yaml (build + retag to PRODUCT_BUILT_IMAGE).
# The test suite bind-mounts from this checkout, so `test` needs it even in
# pull mode; `up`/`verify` do not.
PRODUCT_REPO_ROOT=
PRODUCT_BUILT_IMAGE=localhost/product-harness-product:latest

# Host ports (EDIT-ME: keep them off the common ones to avoid collisions
# with the product's own local dev envs).
PRODUCT_HOST_PORT=18080

# Container user for the runner. Empty = auto-detect: 0:0 under rootless
# Docker/Podman (host uid is unmapped), real uid:gid otherwise.
DOCKER_USER=

# Label for the report directory name (reports/runs/<ts>-<label>).
RUN_LABEL=
